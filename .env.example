# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Credentials (Optional for cloud sync; fallback to local persistence if not configured)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ---- Go 后端（server/）----
# 模型统一使用 gemini-3.1-flash-lite，可用 GEMINI_MODEL 覆盖
GEMINI_MODEL="gemini-3.1-flash-lite"
# AI 可见性测评每日真实探测次数上限，默认 100。每次测评：每个平台 16 次联网提问 + Gemini 约 3~5 次分析调用
# GEMINI_AUDIT_DAILY_LIMIT="100"
# AI 可见性测评的其他探测平台（可选，需同时配置 GEMINI_API_KEY）。国内服务器直连不通时，BASE_URL 填海外中转网关
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-6-luna"
# 推理强度，默认 low（联网提问不需要深度推理）；换成不支持 reasoning 参数的旧模型时设为空字符串
# OPENAI_REASONING_EFFORT="low"
# OPENAI_BASE_URL="https://api.openai.com"
# PERPLEXITY_API_KEY=""
# PERPLEXITY_MODEL="sonar"
# PERPLEXITY_BASE_URL="https://api.perplexity.ai"
# 无法直接开通 Perplexity 时可经 OpenRouter 调用：key 填 OpenRouter 的，BASE_URL 设为 https://openrouter.ai/api/v1，
# 模型名会自动补成 perplexity/sonar
# 推荐：三个平台（ChatGPT / Perplexity / Gemini）统一经 OpenRouter 提问，只需这一把 key，配了就优先于上面的直连配置。
# OPENROUTER_API_KEY=""
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_CHATGPT_MODEL="openai/gpt-6-luna"        # 自动加 :online 后缀开启联网搜索
# OPENROUTER_PERPLEXITY_MODEL="perplexity/sonar"      # Sonar 自带联网
# OPENROUTER_GEMINI_MODEL="google/gemini-3.1-flash-lite"
# OPENROUTER_REASONING_EFFORT="low"                   # 仅用于 ChatGPT；模型不支持时设为空字符串
# 海外出口代理（可选）：国内服务器调用 OpenAI、Google 模型会被地区限制拒绝，经受支持地区（如马来西亚、新加坡）
# 的 HTTP 代理发出。只用于 AI 接口，不影响抓取客户官网
# AI_PROXY_URL="http://用户名:密码@代理IP:8888"
# MySQL 8.4：配置 MYSQL_DATABASE 即启用账号/后台接口，启动时自动执行 server/migrations/*.sql
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="cloudwise"
MYSQL_PASSWORD=""
MYSQL_DATABASE="cloudwise"
# 也可直接给完整 DSN（优先于上面的分项），例如 user:pass@tcp(127.0.0.1:3306)/cloudwise
# MYSQL_DSN=""
# 生产环境置 true：会话 cookie 加 Secure；反向代理（nginx）后面置 TRUST_PROXY=true 以读取 X-Forwarded-For/Proto
COOKIE_SECURE="false"
TRUST_PROXY="false"
# STATIC_DIR 默认 ../dist，Go 进程在 dist 存在时托管前端并做 SPA 回退
# 监听地址（容器内用 127.0.0.1，由宿主机反向代理转发）；默认 0.0.0.0
# LISTEN_HOST="127.0.0.1"
# 有建库/建用户权限的管理员账号：提供后启动时自动建库与专用账号（仅本次启动有效）；首个管理员同理
# MYSQL_ADMIN_USER=""
# MYSQL_ADMIN_PASSWORD=""
# CW_ADMIN_EMAIL=""
# CW_ADMIN_PASSWORD=""
