# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Credentials (Optional for cloud sync; fallback to local persistence if not configured)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ---- Go 后端（server/）----
# 模型统一使用 gemini-3.1-flash-lite，可用 GEMINI_MODEL 覆盖
GEMINI_MODEL="gemini-3.1-flash-lite"
# MySQL 8.4：配置 MYSQL_DATABASE 即启用账号/后台接口，启动时自动执行 server/migrations/*.sql
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="cloudwise"
MYSQL_PASSWORD=""
MYSQL_DATABASE="cloudwise"
# 也可直接给完整 DSN（优先于上面的分项），例如 user:pass@tcp(127.0.0.1:3306)/cloudwise
# MYSQL_DSN=""
# 生产环境置 true：会话 cookie 加 Secure；反向代理（nginx）后面置 TRUST_PROXY=true 以读取 X-Forwarded-For/Proto
COOKIE_SECURE="false"
TRUST_PROXY="false"
# STATIC_DIR 默认 ../dist，Go 进程在 dist 存在时托管前端并做 SPA 回退
