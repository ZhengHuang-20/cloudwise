# 本地开发：复制为 .env.local（.env* 已被 gitignore）。线上在 Vercel 项目的 Settings → Environment Variables 配置。
# 所有变量均可缺省：不配 key 时 AI 接口走确定性 fallback；不配数据库时账号/后台接口返回 503。

# ---- 数据库（Neon Postgres）----
# 在 Vercel 的 Storage / Integrations 里连接 Neon 项目后，DATABASE_URL 与 DATABASE_URL_UNPOOLED 会自动注入。
# 运行时用 pooled 地址；构建前的迁移（scripts/migrate.ts）优先用 unpooled 直连地址。
DATABASE_URL=""
# DATABASE_URL_UNPOOLED=""
# 设为 1 时构建跳过数据库迁移（例如预览部署连的是生产库，又不想在预览构建时迁移）
# SKIP_DB_MIGRATE="1"
# 首个管理员：迁移后若该邮箱不存在则创建（只创建不修改，首次登录需改密）。创建成功后可以删除这两个变量。
# CW_ADMIN_EMAIL=""
# CW_ADMIN_PASSWORD=""
# 会话 cookie 是否强制加 Secure；HTTPS 访问（Vercel）时会自动加，一般不用设
# COOKIE_SECURE="true"

# ---- Gemini（AI 售前顾问 + AI 可见性测评的品牌识别、出题与分析）----
GEMINI_API_KEY=""
# 模型统一使用 gemini-3.1-flash-lite，可用 GEMINI_MODEL 覆盖
# GEMINI_MODEL="gemini-3.1-flash-lite"
# AI 可见性测评每日真实探测次数上限，默认 100。每次测评：每个平台 16 次联网提问 + Gemini 约 3~5 次分析调用
# GEMINI_AUDIT_DAILY_LIMIT="100"
# 是否对外展示 FDE 驻场服务（AI 顾问知识库与 fallback）；不设则跟随 src/lib/features.ts
# SHOW_FDE="true"

# ---- AI 可见性测评的探测平台（可选，需同时配置 GEMINI_API_KEY）----
# 推荐：三个平台（ChatGPT / Perplexity / Gemini）统一经 OpenRouter 提问，只需这一把 key，配了就优先于下面的直连配置。
# OPENROUTER_API_KEY=""
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_CHATGPT_MODEL="openai/gpt-6-luna"        # 自动加 :online 后缀开启联网搜索
# OPENROUTER_PERPLEXITY_MODEL="perplexity/sonar"      # Sonar 自带联网
# OPENROUTER_GEMINI_MODEL="google/gemini-3.1-flash-lite"
# OPENROUTER_REASONING_EFFORT="low"                   # 仅用于 ChatGPT；模型不支持时设为空字符串
# 直连：
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-6-luna"
# 推理强度，默认 low（联网提问不需要深度推理）；换成不支持 reasoning 参数的旧模型时设为空字符串
# OPENAI_REASONING_EFFORT="low"
# OPENAI_BASE_URL="https://api.openai.com"
# PERPLEXITY_API_KEY=""
# PERPLEXITY_MODEL="sonar"
# PERPLEXITY_BASE_URL="https://api.perplexity.ai"
